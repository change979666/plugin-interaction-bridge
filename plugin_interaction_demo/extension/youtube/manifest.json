{
  "manifest_version": 3,
  "name": "YouTube 智能助手",
  "version": "2.0",
  "description": "YouTube Shorts 智能评论助手 - 连接 Python AI 服务 (端口 8088)",
  "action": {
    "default_title": "YouTube 助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8088/*",
    "https://www.youtube.com/*"
  ]
}
